using System;

class Expense
{
    static void Main()
    {
        double totalExpense = 0;

        try
        {
            Console.Write("Enter number of expenses: ");
            int n = Convert.ToInt32(Console.ReadLine());

            for (int i = 1; i <= n; i++)
            {
                Console.Write("Enter expense " + i + ": ");
                double amount = Convert.ToDouble(Console.ReadLine());

                if (amount < 0)
                {
                    throw new Exception("Expense cannot be negative.");
                }

                totalExpense += amount;
            }

            Console.WriteLine("\nTotal Expense = " + totalExpense);
        }
        catch (FormatException)
        {
            Console.WriteLine("Invalid input! Please enter numbers only.");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error: " + ex.Message);
        }
        finally
        {
            Console.WriteLine("Expense tracking completed.");
        }
    }
}
