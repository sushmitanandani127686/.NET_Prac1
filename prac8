// UPDATE: Modify an existing item
protected void btnUpdate_Click(object sender, EventArgs e)
{
int id, qty;
decimal price;
// Server-side validation of the user input
if (!int.TryParse(txtItemID.Text, out id) ||
string.IsNullOrWhiteSpace(txtItemName.Text) ||
!int.TryParse(txtQuantity.Text, out qty) || qty < 0 ||
!decimal.TryParse(txtPrice.Text, out price) || price < 0)
{
lblMessage.Text = "Enter a valid ID and item details.";
return;
}
using (SqlConnection con = new SqlConnection(cs))
using (SqlCommand cmd = new SqlCommand(
"UPDATE Inventory SET ItemName=@name, Quantity=@qty, " +
"Price=@price WHERE ItemID=@id", con))
{
cmd.Parameters.Add("@id", SqlDbType.Int).Value = id;
cmd.Parameters.Add("@name", SqlDbType.VarChar, 100)
.Value = txtItemName.Text.Trim();
cmd.Parameters.Add("@qty", SqlDbType.Int).Value = qty;
cmd.Parameters.Add("@price", SqlDbType.Decimal).Value = price;
cmd.Parameters["@price"].Precision = 10;
cmd.Parameters["@price"].Scale = 2;
con.Open();
int rows = cmd.ExecuteNonQuery(); // rows affected
lblMessage.Text = rows > 0
? "Item updated successfully!"
: "Item ID not found.";
}
